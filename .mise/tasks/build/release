#!/usr/bin/env bash

#MISE description="Build the application (Release)"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/*/Cargo.toml", "crates/*/**/*.rs", "crates/pairidaezad/fixtures/**", ".mise/tasks/build/release"]
#MISE outputs=["target/release/pairidaezad", "target/release/webui"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cargo build --quiet --release --workspace "$@"
