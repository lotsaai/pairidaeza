#!/usr/bin/env bash

#MISE description="Build the application (Release)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**/*.rs", "backend/Cargo.toml", "backend/**/*.rs", "backend/fixtures/**", ".mise/tasks/build/release"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cargo build --quiet --release --workspace "$@"
