#!/usr/bin/env bash

#MISE description="Assemble the Pairidaeza web site into target/dist/web via nsh package"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/app/**", "App.tsx", "auth.ts", "api.ts", "store.ts", "nav.ts", "pages/**", "components/**", "icons/**", "fonts/**", "nsh.json", "theme.json", "tsconfig.json", "mise.toml", ".mise/tasks/dist/web"]
#MISE outputs=["target/dist/web/pairidaeza/index.html"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

nsh package . --target web --out target/dist/web "$@"
