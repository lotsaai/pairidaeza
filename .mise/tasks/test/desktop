#!/usr/bin/env bash

#MISE description="Verify the desktop application, including native authentication"
#MISE depends=["build:debug"]
#MISE daemons=["api"]
#MISE secrets=["TEST_USER", "TEST_USER_EMAIL", "TEST_PASSWORD"]

set -euo pipefail
case "$(uname -s)" in
Darwin) target=macos ;;
Linux) target=linux ;;
MINGW* | MSYS* | CYGWIN*) target=windows ;;
*)
	echo "Unsupported desktop platform: $(uname -s)" >&2
	exit 1
	;;
esac

status=0
for test_file in ./*.test.ts ./*.test.tsx; do
	[[ -f "$test_file" ]] || continue
	if [[ "$test_file" == *.native.test.tsx || "$test_file" == *.headless.test.tsx ]]; then
		nsh test "$test_file" "$@" || status=$?
	else
		nsh test "$test_file" "$@" --target "$target" || status=$?
	fi
done
exit "$status"
