#!/usr/bin/env bash

#MISE description="Run the NSH tests against the managed API"
#MISE depends=["build:debug"]
#MISE daemons=["api"]
#MISE secrets=["TEST_USER", "TEST_USER_EMAIL", "TEST_PASSWORD"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

for test_file in ./*.test.ts ./*.test.tsx; do
	[[ -f "$test_file" ]] || continue
	nsh test "$test_file" "$@"
done
