#!/usr/bin/env bash

#MISE description="Run UI tests on ios using the managed API"
#MISE depends=["build:debug"]
#MISE daemons=["api"]
#MISE secrets=["TEST_USER", "TEST_USER_EMAIL", "TEST_PASSWORD"]

set -euo pipefail
status=0
for test_file in ./auth.integration.test.tsx ./account.test.tsx ./api.test.tsx ./mobile.test.tsx; do
	env -u SDKROOT nsh test "$test_file" "$@" --target ios || status=$?
done
exit "$status"
