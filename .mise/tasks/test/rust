#!/usr/bin/env bash

#MISE description="Run the Rust tests for this project"
#MISE depends=["build:debug"]
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/Cargo.toml", "crates/**/*.rs", "crates/**/postgres/migrations/**"]

