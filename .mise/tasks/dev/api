#!/usr/bin/env bash

#MISE description="Run the development API, serving the packaged web UI"
#MISE depends=["build:debug", "dist:web"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

export PAIRIDAEZA_MOCK_AUTH=true
export PAIRIDAEZA_WEB_DIST="${PAIRIDAEZA_WEB_DIST:-target/dist/web/pairidaezo}"
exec target/debug/pairidaeza-backend "$@"
