#!/usr/bin/env bash

#MISE description="Open the Pairidaeza web app served by the API"
#MISE daemons=["api"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

url=${PAIRIDAEZA_API_URL:-http://127.0.0.1:17810}
case "$(uname -s)" in
Darwin) exec open "$@" "$url" ;;
Linux) exec xdg-open "$url" "$@" ;;
*)
	echo "No supported browser opener for $(uname -s)" >&2
	exit 1
	;;
esac
