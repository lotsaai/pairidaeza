{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "schema": "crates/pairidaezad/postgres/migrations",
      "queries": ["crates/pairidaezad/postgres/queries"],
      "codegen": [
        {
          "plugin": "sqlc-gen-rust",
          "out": "crates/pairidaezad/src/axumext/pgdb",
          "options": {
            "db_crate": "deadpool-postgres",
            "overrides": [
              {
                "db_type": "pg_catalog.timestamptz",
                "rs_type": "jiff::Timestamp",
                "copy_cheap": true
              }
            ]
          }
        }
      ]
    }
  ],
  "plugins": [
    {
      "name": "sqlc-gen-rust",
      "wasm": {
        "url": "https://github.com/tunamaguro/sqlc-gen-rust/releases/download/v0.1.12/sqlc-gen-rust.wasm",
        "sha256": "f434350fd09a485a3c9e94df4808c2d58f7f817937ed2e0654e9180eb96aa9ff"
      }
    }
  ]
}
